# Indian Swing Trading Dashboard – Environment Variables
# Copy this to .env and fill in your values. Never commit .env to version control.

# Server
PORT=3000
NODE_ENV=development

# Project paths (adjust if your Trading folder is in a different location)
TRADING_ROOT=/Users/lakshmikanth/CodeBase/AiProjects/Trading
SKILLS_ROOT=/Users/lakshmikanth/.kiro/skills

# Data refresh interval in milliseconds (default 30 seconds)
REFRESH_INTERVAL_MS=30000

# Scanner job interval in milliseconds (default 5 minutes – heavy operation)
SCANNER_INTERVAL_MS=300000

# Working capital (dynamic – also configurable via dashboard UI)
WORKING_CAPITAL=200000

# Yahoo Finance (free, no key required, but rate-limited)
# No key needed. The backend fetches using a browser user-agent.

# Optional: Groww MCP is used via Kiro skills directly, not via this server
# Leave blank unless you have a separate Groww API key
GROWW_API_KEY=

# NSE India (public endpoints, no key – but cookie session required by some endpoints)
# The india-scanner/india-news python scripts handle cookie sessions
NSE_USER_AGENT=India-Swing-Dashboard/2.0

# Google News RSS (free, no key)
# Rate limit: ~1 request per second per feed

# Database path
DB_PATH=./database/dashboard.sqlite

# Log level: debug | info | warn | error
LOG_LEVEL=info
